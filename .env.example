# Copy to .env for local overrides. Never commit real secrets.
API_PORT=3001
DATA_DIR=./data
# Max upload size in megabytes
MAX_UPLOAD_MB=20

# --- Production / private preview (set these on your host, never in the repo) ---
# NODE_ENV=production        # turns off the dev sign-in shortcut and turns on secure cookies
# SIGNUP_CODE=               # needed to create a new company account (set as a host secret); without it sign-up is closed in production
# ALLOW_OPEN_SIGNUP=1        # lets anyone sign up without a code (not recommended online)
# OPEN_ACCESS=1              # TEMPORARY: no sign-in at all; all visitors share one company. Remove to restore sign-in.
# PREVIEW_PASSWORD=          # optional extra: one browser password in front of the whole site
# WEB_DIST_DIR=apps/web/dist # serve the built web app from the API
# PORT=3001
# HOST=0.0.0.0
# OCR_ENABLED=1              # read scans locally; needs tesseract and pdftoppm installed
